# Copy to .env and fill in. .env is git-ignored and stays on your Mac.

# How to notify: ntfy (default) or whatsapp
NOTIFY=ntfy
# ntfy topics are public to anyone who knows the name: keep it long and random.
NTFY_TOPIC=reed-tennis-CHANGE-ME-random
NTFY_SERVER=https://ntfy.sh

# --- Only needed if NOTIFY=whatsapp ---
# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Twilio's WhatsApp sandbox number (default). Change once you have your own sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your phone, E.164 format
WHATSAPP_TO=whatsapp:+13105551234

# 8:15 release alert: which target weekdays to alert on (date 3 days out).
# Mon = alerts Friday 8:15 for Monday.
OPEN_DAYS=Mon
# Cancellation watcher: which weekdays to keep watching (next 3 days only).
WATCH_DAYS=Mon
# Days that only look for ball machine courts starting at/after EVENING_BM_HOUR.
# Days in OPEN_DAYS/WATCH_DAYS but not here get every court, all day.
EVENING_BM_DAYS=
EVENING_BM_HOUR=17
# Days that look for ANY court (not only ball machine) from EVENING_BM_HOUR on.
EVENING_ANY_DAYS=
WATCH_START_HOUR=7
WATCH_END_HOUR=21

# Only show windows inside these hours (24h clock)
EARLIEST_HOUR=6
LATEST_HOUR=22
